#include <bits/stdc++.h>
using namespace std;
class Solution {
public:
    string convertToTitle(int columnNumber) {
        string res;
        while (columnNumber != 0) {
            --columnNumber;
            int curr = columnNumber % 26;
            char letterToAppend = 'A' + curr;
            res += letterToAppend;
            columnNumber /= 26;
        }
        
        reverse(res.begin(), res.end());
        return res;
    }
};